# Copie para .env.local (dev, opcional) ou cadastre no painel da Vercel (Settings > Environment Variables).
# Em desenvolvimento nada disto é obrigatório: usa um arquivo SQLite local e gera o segredo sozinho.

# Banco (Turso). Em produção são obrigatórios.
DATABASE_URL=libsql://NOME-DO-BANCO-SEU-USUARIO.turso.io
DATABASE_AUTH_TOKEN=

# Segredo que assina a sessão (cookie). Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
